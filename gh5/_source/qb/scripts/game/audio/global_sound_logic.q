	getpakmancurrent \{map = zones}
	switch <pak>
		default
		setsoundbussparams {crowd_beds = {vol = (($default_bussset.crowd_beds.vol) + 5)} time = 0.08}
	endswitch
	wait \{1.5
		seconds}
	gh3_adjustcrowdloopbacktodefault \{time = 4
		normal = 1}
endscript

script gh3_adjustcrowdmedsurge 
	if ($is_attract_mode = 1)
