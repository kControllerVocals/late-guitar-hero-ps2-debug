script gh_sfx_training_tuning_strings 

	switch <note_played>
		case 0
		sound = e_tuning
		case 1
		sound = a_tuning
		case 2
		sound = d_tuning
		case 3
		sound = g_tuning
		case 4
		sound = b_tuning
	endswitch
	switch <training_notes_strummed>
		case 1
		pitch_percent = 80
		default
		pitch_percent = 90
	endswitch
	playsound <sound> vol_percent = 90 pitch_percent = <pitch_percent> buss = training_vo
endscript

