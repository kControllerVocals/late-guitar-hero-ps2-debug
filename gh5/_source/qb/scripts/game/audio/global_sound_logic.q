		setsoundbussparams {crowd_beds = {vol = (($default_bussset.crowd_beds.vol) + 5)} time = 2}
	endswitch
	wait \{4.0
		seconds}
	gh3_adjustcrowdloopbacktodefault \{time = 4
		normal = 1}
