script play_a_short_crowd_swell_for_this_venue 
	if ($0x7bfc9a26 = 1)
		0x8dbdaee4 \{'Skipping crowd swell.'}
		return
	endif
	spawnscriptnow \{0x516f97a5}
	soundevent \{$current_crowd_swell_short_soundevent}
endscript

