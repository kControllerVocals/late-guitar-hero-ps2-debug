script outro_stars 

	0x8dbdaee4 'Outro_Stars: %i' i = <num_stars>
	switch <num_stars>
		case 5
		soundevent \{outro_five_stars}
		case 4
		soundevent \{outro_four_stars}
		case 3
		soundevent \{outro_three_stars}
		case 2
		soundevent \{outro_two_stars}
		case 1
		default
		soundevent \{outro_one_star}
	endswitch
endscript
