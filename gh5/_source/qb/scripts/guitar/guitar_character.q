	endif
	if compositeobjectexists \{vocalist}
		vocalist :hide
	endif
	if compositeobjectexists \{vocalist2}
		vocalist :hide
	endif
	if compositeobjectexists \{drummer}
		drummer :hide
	endif
	if compositeobjectexists \{drummer2}
		drummer :hide
	endif
endscript

script unhide_band 
