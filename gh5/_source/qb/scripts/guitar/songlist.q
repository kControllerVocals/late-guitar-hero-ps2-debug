on_disc_list = gh5_songlist
on_disc_props = gh5_songlist_props
additional_songlist = [
	{
		list = debug_songlist
		props = debug_songlist_props
		frontend_desc = qs("\LDebug")
		crc = debug
	}
	{
		list = tutorial_songlist
		props = tutorial_songlist_props
		frontend_desc = qs("\LTutorial")
