script guitar_create_character_maps 
	CreatePakManMap \{map = highways
		links = Highway_Pakman_Links
		folder = 'pak/models/highway/'
		allocheap = heap_musician1
		no_vram
		numslots = 3}
endscript
anim_pak_state = startup

script anim_paks_set_state \{async = 1}

	if ($anim_pak_state = <state>)
		return
	endif


	switch $anim_pak_state
		case startup
		debug_Printf \{'Nothing to see here'}
		case FrontEnd
		UnloadPakAsync async = <async> pak_name = 'pak/anims/frontend/frontend_anims.pak'
		case ingame
		SmartUnloadPak async = <async> tags = {type = looppak}
		SmartFlushPak async = <async> tags = {type = looppak}
		SmartUnloadPak async = <async> tags = {type = animpak}
		SmartFlushPak async = <async> tags = {type = animpak}
		DumpPakMan
		DestroyPakManMap \{map = loop_anims}
		DestroyPakManMap \{map = Win_Anims}
		DestroyPakManMap \{map = Lose_Anims}
		default

	endswitch
	change anim_pak_state = <state>
	switch ($anim_pak_state)
		case FrontEnd
		LoadPakAsync async = <async> heap = heap_musician_anim pak_name = 'pak/anims/frontend/frontend_anims.pak' no_vram
		case ingame
		MemPushContext \{heap_musician_anim}
		CreatePakManMap \{map = Win_Anims
			links = Anim_Win_Pakman_Links
			folder = 'pak/anims/'
			allocheap = heap_musician_anim
			no_vram
			numslots = 4}
		CreatePakManMap \{map = Lose_Anims
			links = Anim_Lose_Pakman_Links
			folder = 'pak/anims/'
			allocheap = heap_musician_anim
			no_vram
			numslots = 4}
		CreatePakManMap \{map = loop_anims
			links = Anim_Loops_Links
			folder = 'pak/anims/'
			allocheap = heap_musician_anim
			no_vram
			numslots = 4}
		MemPopContext \{heap_musician_anim}
		default

	endswitch
endscript

script get_anim_pak_path 

	if StructureContains Structure = $Anim_Loop_GUIT_Pakman_Links <pak_name>
		path = ($guit_loop_anim_path)
	elseif StructureContains Structure = $Anim_Loop_SING_Pakman_Links <pak_name>
		path = ($sing_loop_anim_path)
	elseif StructureContains Structure = $Anim_Loop_DRUM_Pakman_Links <pak_name>
		path = ($drum_loop_anim_path)
	elseif StructureContains Structure = $Anim_Win_Pakman_Links <pak_name>
		path = ($win_anim_path)
	elseif StructureContains Structure = $Anim_Lose_Pakman_Links <pak_name>
		path = ($lose_anim_path)
	endif
	return path = <path>
endscript

script frontend_anim_paks_are_loaded 
	if ($anim_pak_state = FrontEnd)
		return \{true}
	endif
	return \{false}
endscript

script guitar_force_unload_anim_paks 
endscript
