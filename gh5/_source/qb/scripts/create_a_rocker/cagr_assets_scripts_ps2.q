script edit_graphic_create_pre_menu \{from_launch = 0}
	create_menu_backdrop \{texture = main_menu_bg}
	make_generic_menu \{vmenu_id = cagr_edit_vmenu
		title = qs(0x93873390)
		num_icons = 1}
	if <desc_id> :desc_resolvealias name = 0x44475582 param = 0x7363d093
		<0x7363d093> :obj_spawnscript 0xa7a510a8 params = {0x4d641ae8 0xe99089a3 = $0x187899ed 0xffd05882 = $0xddccbea4}
	else

	endif
	if <desc_id> :desc_resolvealias name = 0xf313b252 param = 0x7c09a415
		<0x7c09a415> :obj_spawnscript 0xa7a510a8 params = {0x4d641ae8 0xe99089a3 = $0x52565f88 0xffd05882 = $0xddccbea4}
	else

	endif
	add_generic_menu_text_item \{text = qs(0x65b8a528)
		pad_choose_script = edit_graphic_create_main_menu}
	add_generic_menu_text_item \{text = qs(0xd40268ee)
		pad_choose_script = 0x659ce062
		pad_choose_params = {
			save
		}}
	add_generic_menu_text_item \{text = qs(0x9f46747e)
		pad_choose_script = 0x659ce062
		pad_choose_params = {
			load
		}}
	add_generic_menu_text_item \{text = qs(0x8f5d9f37)
		pad_choose_script = 0xbe50bfa7
		pad_choose_params = {
			refresh
		}}
	add_generic_menu_text_item \{text = qs(0x28168b25)
		pad_choose_script = edit_graphic_clear_all
		pad_choose_params = {
			refresh
		}}
	menu_finish
	launchevent \{type = focus
		target = cagr_edit_vmenu}
	0x103ee24a \{0xfb1530db}
	0x9b97f817
endscript
screen_element_heap = heap_frontend

script edit_graphic_create_main_menu 
	if isngc
		mempushcontext \{topdownheap}
		change \{screen_element_heap = 0x477fc6de}
	else
		change \{screen_element_heap = heap_frontend}
	endif
	if screenelementexists \{id = cagr_edit_vmenu}
		destroyscreenelement \{id = cagr_edit_vmenu}
	endif
	<layer_num> = 0
	begin
	if NOT (($edit_graphic_layer_infos [<layer_num>].texture_name) = qs(0x00000000))
		<layer_num> = (<layer_num> + 1)
	else
		break
	endif
	repeat 10
	formattext textname = layercount qs(0x075c2162) x = <layer_num>
	make_generic_menu {
		vmenu_id = cagr_edit_vmenu
		title = <layercount>
		num_icons = 1
		show_history
		pad_back_script = edit_graphic_exit_main_menu
	}
	if <desc_id> :desc_resolvealias name = 0x44475582 param = 0x7363d093
		<0x7363d093> :obj_spawnscript 0xa7a510a8 params = {0x4d641ae8 0xe99089a3 = $0x187899ed 0xffd05882 = $0xddccbea4}
	else

	endif
	if <desc_id> :desc_resolvealias name = 0xf313b252 param = 0x7c09a415
		<0x7c09a415> :obj_spawnscript 0xa7a510a8 params = {0x4d641ae8 0xe99089a3 = $0x52565f88 0xffd05882 = $0xddccbea4}
	else

	endif
	if (<layer_num> < 10)
		add_generic_menu_text_item {
			text = qs(0x23052bb7)
			pad_choose_script = edit_graphic_layer_item_select
			pad_choose_params = {my_layer = <layer_num> new}
		}
	endif
	<x> = 0
	<my_text> = qs(0x00000000)
	if (<layer_num> > 0)
		begin
		formattext textname = my_text '%s' s = ($edit_graphic_layer_infos [<x>].texture_name)
		add_generic_menu_text_item {
			text = <my_text>
			pad_choose_script = edit_graphic_layer_item_select
			pad_choose_params = {my_layer = <x>}
		}
		x = (<x> + 1)
		repeat <layer_num>
	endif
	0x103ee24a
	menu_finish
	launchevent \{type = focus
		target = cagr_edit_vmenu}
endscript

script edit_graphic_exit_main_menu 
	edit_graphic_prepare_sprite_infos
	unpauseskaters
	wait \{5
		gameframes}
	pauseskaters
	if screenelementexists \{id = current_menu_anchor}
		destroyscreenelement \{id = current_menu_anchor}
	endif
	clean_up_user_control_helpers
	edit_graphic_create_pre_menu
	if isngc
		mempopcontext
	endif
endscript

script edit_graphic_create_layer_menu 
	if screenelementexists \{id = cagr_edit_vmenu}
		destroyscreenelement \{id = cagr_edit_vmenu}
	endif
	0x66709f27 = ($edit_graphic_layer_infos [($eg_current_layer_info_index)])
	if 0x1a06d833 texture_id = (<0x66709f27>.texture_id)
		sponsor_logo = 1
	endif
	make_generic_menu \{vmenu_id = cagr_edit_vmenu
		title = qs(0x3a03d46e)
		num_icons = 1
		show_history
		pad_back_script = edit_graphic_create_main_menu}
	if <desc_id> :desc_resolvealias name = 0x44475582 param = 0x7363d093
		<0x7363d093> :obj_spawnscript 0xa7a510a8 params = {0x4d641ae8 0xe99089a3 = $0x187899ed 0xffd05882 = $0xddccbea4}
	else

	endif
	if <desc_id> :desc_resolvealias name = 0xf313b252 param = 0x7c09a415
		<0x7c09a415> :obj_spawnscript 0xa7a510a8 params = {0x4d641ae8 0xe99089a3 = $0x52565f88 0xffd05882 = $0xddccbea4}
	else

	endif
	if NOT gotparam \{sponsor_logo}
		add_generic_menu_button_icon_item \{icon = widget_colorwheel
			text = qs(0x6149aa3d)
			pad_choose_script = 0xfb118fd9}
		button_widget_add_item \{widget_id = transparency
			text = qs(0x3d6d9684)
			button_icon = widget_transparency
			min = 0
			max = 255
			start_value = 255
			step = 5
			pad_up_script = image_transparency
			pad_up_params = {
				up
			}
			pad_down_script = image_transparency
			pad_down_params = {
				down
			}
			fill_type = `bottom to top`
			0x25e61009 = 1}
	endif
	button_widget_add_item \{widget_id = scale
		text = qs(0x48caed16)
		button_icon = widget_scale
		min = 0.5
		max = 6
		start_value = 3
		step = 0.1
		pad_up_script = scale_image
		pad_up_params = {
			up
		}
		pad_down_script = scale_image
		pad_down_params = {
			down
		}
		fill_type = `center out`
		0x25e61009 = 1}
	button_widget_add_item \{widget_id = horiz_move
		text = qs(0xc261e706)
		button_icon = widget_uni_move
		start_value = 100
		min = 0
		max = 200
		step = 1
		pad_up_script = move_image
		pad_up_params = {
			horiz
		}
		pad_down_script = move_image
		pad_down_params = {
			horiz
		}
		fill_type = `center left/right`
		icon_rot = 90
		0x25e61009 = 1}
	button_widget_add_item \{widget_id = vert_move
		text = qs(0xbc37bc4e)
		button_icon = widget_uni_move
		start_value = 100
		min = 0
		max = 200
		step = 1
		pad_up_script = move_image
		pad_up_params = {
			vert
		}
		pad_down_script = move_image
		pad_down_params = {
			vert
		}
		fill_type = `center up/down`
		0x25e61009 = 1}
	if NOT gotparam \{sponsor_logo}
		rot_widget_add_item \{widget_id = rot_widget
			text = qs(0x63e34942)
			button_icon = widget_rotate
			start_value = 0
			min = 0
			max = 360
			step = 1
			pad_up_script = rotate_image
			pad_down_script = rotate_image
			fill_type = `counter clockwise`
			wrap
			sweep
			0x25e61009 = 1}
		if (($edit_graphic_layer_infos [$eg_current_layer_info_index].flip_h) = 1)
			horiz_on = true
		endif
		add_generic_menu_button_icon_item {
			icon = widget_flip
			text = qs(0xc619fe8a)
			pad_choose_script = edit_graphic_flip_layer
			pad_choose_params = {horiz = 1}
			icon_rot = 90
			on = <horiz_on>
		}
		if (($edit_graphic_layer_infos [$eg_current_layer_info_index].flip_v) = 1)
			vert_on = true
		endif
		add_generic_menu_button_icon_item {
			icon = widget_flip
			text = qs(0x2916c9f2)
			pad_choose_script = edit_graphic_flip_layer
			pad_choose_params = {vert = 1}
			on = <vert_on>
		}
	endif
	add_generic_menu_icon_item \{icon = widget_default
		text = qs(0x675459e3)
		pad_choose_script = default_image}
	add_generic_menu_button_icon_item \{icon = widget_delete
		text = qs(0x5bbcb1d5)
		pad_choose_script = 0xdd79f470}
	if ($eg_current_layer_info_index < 9)
		add_generic_menu_text_item \{text = qs(0xbe028806)
			pad_choose_script = 0x910bd9ac}
	endif
	if 0x99575848
		add_generic_menu_text_item \{text = qs(0x5dbac635)
			pad_choose_script = 0x5c2fa1de}
	endif
	menu_finish
	launchevent \{type = focus
		target = cagr_edit_vmenu}
endscript

script scale_image 
	edit_graphic_change_layer_info_value change_scale = <value>
	0x103ee24a
endscript

script image_transparency 
	casttointeger \{value}
	edit_graphic_change_layer_info_value 0x73cf7bd8 = <value>
	0x103ee24a
endscript

script rotate_image 
	casttointeger \{value}
	edit_graphic_change_layer_info_value change_rot = <value>
	0x103ee24a
endscript

script move_image 
	casttointeger \{value}
	if gotparam \{horiz}
		edit_graphic_change_layer_info_value change_pos_x = <value>
	elseif gotparam \{vert}
		edit_graphic_change_layer_info_value change_pos_y = <value>
	endif
	0x103ee24a
endscript

script default_image 
	edit_graphic_change_layer_info_value {change_pos_x = (100)
		change_pos_y = (100)
		change_rot = 0
		change_scale = 3
		change_flip_h = 0
		change_flip_v = 0
		0x73cf7bd8 = 255
		change_color = grey_5
	}
	0x103ee24a
	0x26d6c0e3
endscript

script 0x26d6c0e3 
	button_widget_set_value \{widget_id = transparency
		new_value = 255}
	button_widget_set_value \{widget_id = scale
		new_value = 3}
	button_widget_set_value \{widget_id = horiz_move
		new_value = 100}
	button_widget_set_value \{widget_id = vert_move
		new_value = 100}
	rotate_widget_set_value \{widget_id = rot_widget
		new_value = 0}
	button_generic_set_value \{id = flip_horiz_widget
		new_value = false}
	button_generic_set_value \{id = flip_vert_widget
		new_value = false}
endscript

script 0x103ee24a 
	if screenelementexists \{id = 0x7c19d7b6}
		destroyscreenelement \{id = 0x7c19d7b6}
	endif
	createscreenelement \{type = containerelement
		parent = root_window
		id = 0x7c19d7b6
		dims = (192.0, 192.0)
		pos = (950.0, 350.0)
		heap = $screen_element_heap}
	if gotparam \{0xfb1530db}
		0xa035885b
		createscreenelement \{type = spriteelement
			parent = 0x7c19d7b6
			id = 0x8300e268
			pos = (100.0, 100.0)
			texture = cag_workspace
			z_priority = 30
			dims = (194.0, 194.0)}
		return
	endif
	createscreenelement \{type = spriteelement
		parent = 0x7c19d7b6
		id = 0xea29d13a
		texture = 0x975854fe
		z_priority = 999
		dims = (194.0, 194.0)
		pos = (100.0, 100.0)}
	<index> = 0
	begin
	layer = ($edit_graphic_layer_infos [<index>])
	if NOT ((<layer>.texture_name) = qs(0x00000000))
		pos = ((1.0, 0.0) * (<layer>.pos_x) + (0.0, 1.0) * (200 - <layer>.pos_y))
		0xfaa42e22 index = <index>
		createscreenelement {
			type = spriteelement
			parent = 0x7c19d7b6
			id = (<layer>.texture_name)
			pos = <pos>
			texture = (<layer>.texture_id)
			z_priority = (10 + <index>)
			rgba = <rgba>
			scale = (<layer>.scale)
			rot_angle = (<layer>.rot)
		}
		if (<layer>.flip_v = 1)
			setscreenelementprops id = <id> flip_h
		endif
		if (<layer>.flip_h = 1)
			setscreenelementprops id = <id> flip_v
		endif
	endif
	<index> = (<index> + 1)
	repeat 10
	if gotparam \{name}
		createscreenelement {
			type = spriteelement
			parent = 0x7c19d7b6
			id = <name>
			pos = (100.0, 100.0)
			texture = <name>
			z_priority = (20 + <index>)
			scale = 3.0
		}
	endif
endscript

script edit_graphic_layer_item_select 
	change eg_current_layer_info_index = <my_layer>
	if gotparam \{new}
		edit_graphic_create_category_menu
	else
		edit_graphic_create_layer_menu
	endif
endscript

script edit_graphic_update_layer_graphics \{update_all = 1}
	if NOT getscreenelementchildren \{id = cagr_edit_vmenu}

		return
	endif
	getarraysize ($edit_graphic_layer_infos)
	if (<array_size> <= 0)
