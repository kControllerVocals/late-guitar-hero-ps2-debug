	endif
endscript

script Play_A_Short_Crowd_Swell_For_This_Venue 
	if ($g_hack_wait_for_okay_to_cheer = 1)
		debug_Printf \{'Skipping crowd swell.'}
		return
	endif
	spawnscriptnow \{hack_wait_for_cheer}
