script GH_SFX_Training_Tuning_Strings 

	switch <note_played>
		case 0
		Sound = E_Tuning
		case 1
		Sound = A_Tuning
		case 2
		Sound = D_Tuning
		case 3
		Sound = G_Tuning
		case 4
		Sound = B_Tuning
	endswitch
	switch <training_notes_strummed>
		case 1
		pitch_percent = 80
		default
		pitch_percent = 90
	endswitch
	PlaySound <Sound> vol_percent = 90 pitch_percent = <pitch_percent> buss = Training_VO
endscript

