script edit_graphic_create_pre_menu \{from_launch = 0}
	create_menu_backdrop \{texture = song_summary_bg_lo_z}
	make_generic_menu \{vmenu_id = cagr_edit_vmenu
		title = qs("EDIT BAND LOGO")
		num_icons = 1}
	if <desc_id> :Desc_ResolveAlias name = alias_banner_art_glow param = banner_glow_id
		<banner_glow_id> :obj_spawnscript ui_flicker_glow params = {as_offset scale_movement = $banner_move glow_brightness = $menu_glow}
	else

	endif
	if <desc_id> :Desc_ResolveAlias name = alias_skulls_glow param = skulls_glow_id
		<skulls_glow_id> :obj_spawnscript ui_flicker_glow params = {as_offset scale_movement = $skulls_move glow_brightness = $menu_glow}
	else

	endif
	add_generic_menu_text_item \{text = qs("Edit")
		pad_choose_script = edit_graphic_create_main_menu}
	add_generic_menu_text_item \{text = qs("Save")
		pad_choose_script = edit_graphic_send_off_to_save_load
		pad_choose_params = {
			save
		}}
	add_generic_menu_text_item \{text = qs("Load")
		choose_state = UIstate_generic_dialogue
		choose_state_data = {
			is_popup
			title = qs("LOAD DESIGN?")
			text = qs("By loading, your old design will be lost. Would you like to continue?")
			choose_yes_func = edit_graphic_send_off_to_save_load
			choose_yes_params = {
				load
			}
		}}
	add_generic_menu_text_item \{icon = icon_random
		text = qs("Random")
		choose_state = UIstate_generic_dialogue
		choose_state_data = {
			is_popup
			title = qs("RANDOM DESIGN?")
			text = qs("By selecting random your old design will be lost. Would you like to continue?")
			choose_yes_func = edit_graphic_set_random
			choose_yes_params = {
				refresh
			}
		}}
	add_generic_menu_text_item \{text = qs("Clear")
		choose_state = UIstate_generic_dialogue
		choose_state_data = {
			is_popup
			title = qs("CLEAR DESIGN?")
			text = qs("By selecting clear your old design will be lost. Would you like to continue?")
			choose_yes_func = edit_graphic_clear_all
			choose_yes_params = {
				refresh
			}
		}}
	menu_finish
	LaunchEvent \{type = focus
		target = cagr_edit_vmenu}
	edit_graphic_create_preview \{Generate_Logo}
	edit_graphic_save_data_to_global
endscript

script ui_return_cagr 
	menu_finish
endscript
screen_element_heap = heap_frontend

script edit_graphic_create_main_menu 
	if IsNgc
		MemPushContext \{TopDownHeap}
		change \{screen_element_heap = TopDown}
	else
		change \{screen_element_heap = heap_frontend}
	endif
	if ScreenElementExists \{id = cagr_edit_vmenu}
		DestroyScreenElement \{id = cagr_edit_vmenu}
	endif
	<layer_num> = 0
	begin
	if NOT (($edit_graphic_layer_infos [<layer_num>].texture_name) = qs(""))
		<layer_num> = (<layer_num> + 1)
	else
		break
	endif
	repeat 10
	FormatText TextName = LayerCount qs(0x075c2162) x = <layer_num>
	make_generic_menu {
		vmenu_id = cagr_edit_vmenu
		title = <LayerCount>
		num_icons = 1
		show_history
		pad_back_script = edit_graphic_exit_main_menu
	}
	if <desc_id> :Desc_ResolveAlias name = alias_banner_art_glow param = banner_glow_id
		<banner_glow_id> :obj_spawnscript ui_flicker_glow params = {as_offset scale_movement = $banner_move glow_brightness = $menu_glow}
	else

	endif
	if <desc_id> :Desc_ResolveAlias name = alias_skulls_glow param = skulls_glow_id
		<skulls_glow_id> :obj_spawnscript ui_flicker_glow params = {as_offset scale_movement = $skulls_move glow_brightness = $menu_glow}
	else

	endif
	if (<layer_num> < 10)
		add_generic_menu_text_item {
			text = qs("< New Layer >")
			pad_choose_script = edit_graphic_layer_item_select
			pad_choose_params = {my_layer = <layer_num> new}
		}
	endif
	<x> = 0
	<my_text> = qs("")
	if (<layer_num> > 0)
		begin
		FormatText TextName = my_text '%s' s = ($edit_graphic_layer_infos [<x>].texture_name)
		add_generic_menu_text_item {
			text = <my_text>
			pad_choose_script = edit_graphic_layer_item_select
			pad_choose_params = {my_layer = <x>}
		}
		x = (<x> + 1)
		repeat <layer_num>
	endif
	edit_graphic_create_preview
	menu_finish
	LaunchEvent \{type = focus
		target = cagr_edit_vmenu}
endscript

script edit_graphic_exit_main_menu 
	edit_graphic_prepare_sprite_infos
	unpauseskaters
	Wait \{5
		gameframes}
	pauseskaters
	if ScreenElementExists \{id = current_menu_anchor}
		DestroyScreenElement \{id = current_menu_anchor}
	endif
	clean_up_user_control_helpers
	edit_graphic_create_pre_menu
	if IsNgc
		MemPopContext
	endif
endscript

script edit_graphic_create_layer_menu 
	if ScreenElementExists \{id = cagr_edit_vmenu}
		DestroyScreenElement \{id = cagr_edit_vmenu}
	endif
	layer_copy = ($edit_graphic_layer_infos [($EG_current_layer_info_index)])
	if edit_graphic_get_logo_sponsor texture_id = (<layer_copy>.texture_id)
		sponsor_logo = 1
	endif
	make_generic_menu \{vmenu_id = cagr_edit_vmenu
		title = qs("Edit Design")
		num_icons = 1
		show_history
		pad_back_script = edit_graphic_create_main_menu}
	if <desc_id> :Desc_ResolveAlias name = alias_banner_art_glow param = banner_glow_id
		<banner_glow_id> :obj_spawnscript ui_flicker_glow params = {as_offset scale_movement = $banner_move glow_brightness = $menu_glow}
	else

	endif
	if <desc_id> :Desc_ResolveAlias name = alias_skulls_glow param = skulls_glow_id
		<skulls_glow_id> :obj_spawnscript ui_flicker_glow params = {as_offset scale_movement = $skulls_move glow_brightness = $menu_glow}
	else

	endif
	if NOT GotParam \{sponsor_logo}
		add_generic_menu_icon_item \{icon = widget_colorwheel
			text = qs("Color")
			pad_choose_script = edit_graphic_color_wheel}
		button_widget_add_item \{widget_id = Transparency
			text = qs("Transparency")
			button_icon = widget_transparency
			min = 0
			max = 255
			start_value = 255
			step = 5
			pad_up_script = image_transparency
			pad_up_params = {
				up
			}
			pad_down_script = image_transparency
			pad_down_params = {
				down
			}
			fill_type = `Bottom to Top`
			color_text_on_focus = 1}
	endif
	button_widget_add_item \{widget_id = scale
		text = qs("Scale")
		button_icon = widget_scale
		min = 0.5
		max = 6
		start_value = 3
		step = 0.1
		pad_up_script = scale_image
		pad_up_params = {
			up
		}
		pad_down_script = scale_image
		pad_down_params = {
			down
		}
		fill_type = `Center Out`
		color_text_on_focus = 1}
	button_widget_add_item \{widget_id = horiz_move
		text = qs("Horizontal")
		button_icon = widget_uni_move
		start_value = 100
		min = 0
		max = 200
		step = 1
		pad_up_script = move_image
		pad_up_params = {
			horiz
		}
		pad_down_script = move_image
		pad_down_params = {
			horiz
		}
		fill_type = `Center Left/Right`
		icon_rot = 90
		color_text_on_focus = 1}
	button_widget_add_item \{widget_id = vert_move
		text = qs("Vertical")
		button_icon = widget_uni_move
		start_value = 100
		min = 0
		max = 200
		step = 1
		pad_up_script = move_image
		pad_up_params = {
			vert
		}
		pad_down_script = move_image
		pad_down_params = {
			vert
		}
		fill_type = `Center Up/Down`
		color_text_on_focus = 1}
	if NOT GotParam \{sponsor_logo}
		rot_widget_add_item \{widget_id = rot_widget
			text = qs("Rotate")
			button_icon = widget_rotate
			start_value = 0
			min = 0
			max = 360
			step = 1
			pad_up_script = rotate_image
			pad_down_script = rotate_image
			fill_type = `Counter Clockwise`
			wrap
			sweep
			color_text_on_focus = 1}
		if (($edit_graphic_layer_infos [$EG_current_layer_info_index].flip_h) = 1)
			horiz_on = true
		endif
		add_generic_menu_icon_item \{icon = widget_flip
			text = qs("Flip Horiz.")
			pad_choose_script = edit_graphic_flip_layer
			pad_choose_params = {
				horiz = 1
			}
			icon_rot = 90}
		if (($edit_graphic_layer_infos [$EG_current_layer_info_index].flip_v) = 1)
			vert_on = true
		endif
		add_generic_menu_icon_item \{icon = widget_flip
			text = qs("Flip Vert.")
			pad_choose_script = edit_graphic_flip_layer
			pad_choose_params = {
				vert = 1
			}}
	endif
	add_generic_menu_icon_item \{icon = widget_default
		text = qs("Default")
		pad_choose_script = default_image}
	add_generic_menu_icon_item \{icon = widget_delete
		text = qs("Delete Layer")
		choose_state = UIstate_generic_dialogue
		choose_state_data = {
			is_popup
			title = qs("DELETE LAYER?")
			text = qs("By selecting delete your layer will be lost. Would you like to continue?")
			choose_yes_func = edit_graphic_delete_layer
		}}
	if ($EG_current_layer_info_index < 9)
		add_generic_menu_text_item \{text = qs(0xbe028806)
			pad_choose_script = edit_graphic_bring_layer_to_front}
	endif
	if edit_graphic_find_nearest_open_layer
		add_generic_menu_text_item \{text = qs(0x5dbac635)
			pad_choose_script = edit_graphic_copy_layer}
	endif
	menu_finish
	LaunchEvent \{type = focus
		target = cagr_edit_vmenu}
endscript

script scale_image 
	edit_graphic_change_layer_info_value change_scale = <value>
	edit_graphic_create_preview
endscript

script image_transparency 
	CastToInteger \{value}
	edit_graphic_change_layer_info_value change_alpha = <value>
	edit_graphic_create_preview
endscript

script rotate_image 
	CastToInteger \{value}
	edit_graphic_change_layer_info_value change_rot = <value>
	edit_graphic_create_preview
endscript

script move_image 
	CastToInteger \{value}
	if GotParam \{horiz}
		edit_graphic_change_layer_info_value change_pos_x = <value>
	elseif GotParam \{vert}
		edit_graphic_change_layer_info_value change_pos_y = <value>
	endif
	edit_graphic_create_preview
endscript

script default_image 
	edit_graphic_change_layer_info_value {change_pos_x = (100)
		change_pos_y = (100)
		change_rot = 0
		change_scale = 3
		change_flip_h = 0
		change_flip_v = 0
		change_alpha = 255
		change_color = grey_5
	}
	edit_graphic_create_preview
	edit_graphic_reset_widgets
endscript

script edit_graphic_reset_widgets 
	button_widget_set_value \{widget_id = Transparency
		new_value = 255}
	button_widget_set_value \{widget_id = scale
		new_value = 3}
	button_widget_set_value \{widget_id = horiz_move
		new_value = 100}
	button_widget_set_value \{widget_id = vert_move
		new_value = 100}
	rotate_widget_set_value \{widget_id = rot_widget
		new_value = 0}
	button_generic_set_value \{id = flip_horiz_widget
		new_value = false}
	button_generic_set_value \{id = flip_vert_widget
		new_value = false}
endscript

script edit_graphic_create_preview 
	if ScreenElementExists \{id = image_preview_container}
		DestroyScreenElement \{id = image_preview_container}
	endif
	CreateScreenElement \{type = ContainerElement
		parent = root_window
		id = image_preview_container
		dims = (192.0, 192.0)
		pos = (950.0, 350.0)
		heap = $screen_element_heap}
	CreateScreenElement \{type = SpriteElement
		parent = image_preview_container
		dims = (222.0, 222.0)
		pos = (100.0, 100.0)
		texture = logo_bg
		alpha = 0.3
		z_priority = 0.5
		rgba = GH51_red_lt}
	if GotParam \{Generate_Logo}
		edit_graphic_refresh_cag_texture
		CreateScreenElement \{type = SpriteElement
			parent = image_preview_container
			id = cag_logo
			pos = (100.0, 100.0)
			texture = cag_workspace
			z_priority = 30
			dims = (194.0, 194.0)}
		return
	endif
	CreateScreenElement \{type = SpriteElement
		parent = image_preview_container
		id = cag_clip_frame_image
		texture = cag_clip_frame
		z_priority = 499
		dims = (194.0, 194.0)
		pos = (100.0, 100.0)}
	<index> = 0
	begin
	layer = ($edit_graphic_layer_infos [<index>])
	if NOT ((<layer>.texture_name) = qs(""))
		pos = ((1.0, 0.0) * (<layer>.pos_x) + (0.0, 1.0) * (200 - <layer>.pos_y))
		edit_graphic_color_get_rgba index = <index>
		CreateScreenElement {
			type = SpriteElement
			parent = image_preview_container
			id = (<layer>.texture_name)
			pos = <pos>
			texture = (<layer>.texture_id)
			z_priority = (10 + <index>)
			rgba = <rgba>
			scale = (<layer>.scale)
			rot_angle = (<layer>.rot)
		}
		if (<layer>.flip_v = 1)
			SetScreenElementProps id = <id> flip_h
		endif
		if (<layer>.flip_h = 1)
			SetScreenElementProps id = <id> flip_v
		endif
	endif
	<index> = (<index> + 1)
	repeat 10
	if GotParam \{name}
		CreateScreenElement {
			type = SpriteElement
			parent = image_preview_container
			id = <name>
			pos = (100.0, 100.0)
			texture = <name>
			z_priority = (20 + <index>)
			scale = 3.0
		}
	endif
endscript

script edit_graphic_layer_item_select 
	change EG_current_layer_info_index = <my_layer>
	if GotParam \{new}
		edit_graphic_create_category_menu
	else
		edit_graphic_create_layer_menu
	endif
endscript

script edit_graphic_update_layer_graphics \{update_all = 1}
	if NOT GetScreenElementChildren \{id = cagr_edit_vmenu}

		return
	endif
	GetArraySize ($edit_graphic_layer_infos)
	if (<array_size> <= 0)
		change edit_graphic_layer_infos = ($default_graphic_layer_info)
	endif
	<layer_info_index> = $EG_current_layer_menu_index
	if (<update_all> = 1)
		GetArraySize <children>
		<menu_index> = 0
	else
		<array_size> = 3
		<menu_index> = <index>
	endif
	begin
	<menu_item> = (<children> [<menu_index>])
	<menu_item> :GetTags
	if (($edit_graphic_layer_infos [<layer_info_index>].texture_id) = none)
		if (($edit_graphic_layer_infos [<layer_info_index>].string) = qs(""))
			<thumb_texture> = white2
			<thumb_scale> = $EG_thumb_scale
			<thumb_pos> = $EG_thumb_pos
			<thumb_rgba> = [255 , 255 , 255 , 0]
			<canvas_scale> = $EG_canvas_scale_factor
			<canvas_rgba> = [255 , 255 , 255 , 0]
			<offset> = (0.0, 0.0)
		else
			edit_graphic_destroy_image_string use_current = 0 info_index = <layer_info_index>
			edit_graphic_build_image_string info_index = <layer_info_index> menu_index = <menu_index>
			edit_graphic_get_thumb_texture info_index = <layer_info_index>
			<thumb_texture> = <thumb_texture>
			<thumb_scale> = (0.29, 0.29)
			<thumb_pos> = (52.0, 3.0)
			HSVtoRGB hsv = ($edit_graphic_layer_infos [<layer_info_index>].hsva)
			<thumb_rgba> = <rgb>
			<canvas_scale> = (($edit_graphic_layer_infos [<layer_info_index>].scale) * $EG_canvas_scale_factor)
			<canvas_rgba> = [255 , 255 , 255 , 0]
			<offset> = (((1.0, 0.0) * ((8 * <canvas_scale>) / 2)) + ((0.0, 1.0) * ((8 * <canvas_scale>) / 2)))
		endif
		<canvas_texture> = white2
	else
		<thumb_texture> = ($edit_graphic_layer_infos [<layer_info_index>].texture_id)
		<thumb_scale> = $EG_thumb_scale
		<thumb_pos> = $EG_thumb_pos
		HSVtoRGB hsv = ($edit_graphic_layer_infos [<layer_info_index>].hsva)
		<thumb_rgba> = <rgb>
		<canvas_texture> = ($edit_graphic_layer_infos [<layer_info_index>].texture_id)
		<canvas_scale> = (($edit_graphic_layer_infos [<layer_info_index>].scale) * $EG_canvas_scale_factor)
		<canvas_rgba> = <rgb>
		<offset> = (0.0, 0.0)
	endif
	if (($edit_graphic_layer_infos [<layer_info_index>].flip_v) = 1)
		<flipv> = flip_h
	endif
	if (($edit_graphic_layer_infos [<layer_info_index>].flip_h) = 1)
		<fliph> = flip_v
	endif
	SetScreenElementProps {
		id = {<menu_item> child = 2}
		texture = <thumb_texture>
		rgba = <thumb_rgba>
		pos = <thumb_pos>
	}
	SetScreenElementProps id = {<menu_item> child = 2} scale = <thumb_scale> time = 0
	<canvas_id> = ($edit_graphic_layer_infos [<layer_info_index>].canvas_id)
	<rot_angle> = ($edit_graphic_layer_infos [<layer_info_index>].rot)
	<pos_x> = ($edit_graphic_layer_infos [<layer_info_index>].pos_x)
	<pos_y> = ($edit_graphic_layer_infos [<layer_info_index>].pos_y)
	<pos> = (((1.0, 0.0) * <pos_x>) + ((0.0, 1.0) * <pos_y>))
	<pos> = (<pos> * 2.875)
	<menu_index> = (<menu_index> + 1)
	RemoveParameter \{layer_info_index}
	RemoveParameter \{flipv}
	RemoveParameter \{fliph}
	repeat (<array_size> -2)
endscript

script edit_graphic_get_thumb_texture 
	<layer_string> = ($edit_graphic_layer_infos [<info_index>].string)
	StringToCharArray string = <layer_string>
	GetArraySize <char_array>
	<font> = (EG_font_names [($edit_graphic_layer_infos [<info_index>].font_id)].name)
	<index> = 0
	begin
	if NOT ((<char_array> [<index>]) = ' ')
		<char> = (<char_array> [<index>])
		break
	endif
	<index> = (<index> + 1)
	repeat <array_size>
	FormatText checksumname = texture '%f_%l' f = <font> l = <char>
	return thumb_texture = <texture>
endscript

script edit_graphic_create_category_menu 
	if ScreenElementExists \{id = cagr_edit_vmenu}
		DestroyScreenElement \{id = cagr_edit_vmenu}
	endif
	edit_graphic_create_preview
	make_generic_menu \{vmenu_id = cagr_edit_vmenu
		title = qs("Categories")
		pad_back_script = edit_graphic_create_main_menu
		num_icons = 1
		show_history}
	if <desc_id> :Desc_ResolveAlias name = alias_banner_art_glow param = banner_glow_id
		<banner_glow_id> :obj_spawnscript ui_flicker_glow params = {as_offset scale_movement = $banner_move glow_brightness = $menu_glow}
	else

	endif
	if <desc_id> :Desc_ResolveAlias name = alias_skulls_glow param = skulls_glow_id
		<skulls_glow_id> :obj_spawnscript ui_flicker_glow params = {as_offset scale_movement = $skulls_move glow_brightness = $menu_glow}
	else

	endif
	GetArraySize \{$car_logo_master_list}
	i = 0
	begin
	logo_structure = ($car_logo_master_list [<i>])
	add_generic_menu_text_item {
		text = (<logo_structure>.FE_Text)
		pad_choose_script = edit_graphic_create_image_menu
		pad_choose_params = {index = 1 category = (<logo_structure>.list)}
	}
	i = (<i> + 1)
	repeat <array_size>
	menu_finish
	LaunchEvent \{type = focus
		target = cagr_edit_vmenu}
endscript

script edit_graphic_create_image_menu 
	title = 'None'
	title_pos = (56.0, 0.0)
	array_name = none
	GetArraySize \{$car_logo_master_list}
	i = 0
	begin
	logo_structure = ($car_logo_master_list [<i>])
	if (<logo_structure>.list = <category>)
		title = (<logo_structure>.FE_Text)
		array_name = ($<category>)
		break
	endif
	i = (<i> + 1)
	repeat <array_size>
	if ScreenElementExists \{id = cagr_edit_vmenu}
		DestroyScreenElement \{id = cagr_edit_vmenu}
	endif
	make_generic_menu {
		vmenu_id = cagr_edit_vmenu
		pad_back_script = edit_graphic_create_category_menu
		title = <title>
		num_icons = 1
	}
	if <desc_id> :Desc_ResolveAlias name = alias_banner_art_glow param = banner_glow_id
		<banner_glow_id> :obj_spawnscript ui_flicker_glow params = {as_offset scale_movement = $banner_move glow_brightness = $menu_glow}
	else

	endif
	if <desc_id> :Desc_ResolveAlias name = alias_skulls_glow param = skulls_glow_id
		<skulls_glow_id> :obj_spawnscript ui_flicker_glow params = {as_offset scale_movement = $skulls_move glow_brightness = $menu_glow}
	else

	endif
	if NOT (<array_name> = none)
		GetArraySize <array_name> GlobalArray
		<index> = 0
		<hcounter> = 0
		<row_counter> = 0
		begin
		texture_name = (<array_name> [<index>])
		FormatText TextName = name '%t' t = <texture_name>
		FormatText checksumname = texture_id '%t' t = <texture_name>
		add_generic_menu_text_item {
			text = <name>
			additional_focus_script = edit_graphic_create_preview
			additional_focus_params = {name = <texture_id>}
			pad_choose_script = edit_graphic_image_item_select
			pad_choose_params = {texture = <texture_id> texture_name = <name>}
		}
		<index> = (<index> + 1)
		repeat <array_size>
	endif
	menu_finish
	LaunchEvent \{type = focus
		target = cagr_edit_vmenu}
endscript

script edit_graphic_image_item_select 
	edit_graphic_change_layer_info_value change_texture_id = <texture> change_texture_name = <texture_name>
	edit_graphic_prepare_sprite_infos
	edit_graphic_create_preview
	edit_graphic_create_layer_menu
endscript

script edit_graphic_swap_layers 
	GetScreenElementChildren \{id = edit_graphic_layer_vmenu}
	<this_layer> = (<children> [$EG_current_layer_menu_index])
	<this_layer> :GetTags
	<this_layer_index> = <layer_info_index>
	<this_menu_index> = <tag_grid_x>
	RemoveParameter \{layer_info_index}
	if (GotParam swap_up)
		<selected_tool_id> = swap_backward
		<pad_event> = pad_up
		<other_layer_menu_index> = ($EG_current_layer_menu_index -1)
		<other_layer> = (<children> [<other_layer_menu_index>])
	endif
	if (GotParam swap_down)
		<selected_tool_id> = swap_forward
		<pad_event> = pad_down
		<other_layer_menu_index> = ($EG_current_layer_menu_index + 1)
		<other_layer> = (<children> [<other_layer_menu_index>])
	endif
	<other_layer> :GetTags
	<other_layer_index> = <layer_info_index>
	<other_menu_index> = <tag_grid_x>
	SetScreenElementProps {
		id = <this_layer>
		tags = {layer_info_index = <other_layer_index>}
	}
	SetScreenElementProps {
		id = <other_layer>
		tags = {layer_info_index = <this_layer_index>}
	}
	edit_graphic_change_layer_info_value {use_current = 0 index = <other_layer_index>
		change_layer_id = <this_menu_index>
	}
	edit_graphic_change_layer_info_value {use_current = 0 index = <this_layer_index>
		change_layer_id = <other_menu_index>
	}
	change EG_current_layer_menu_index = <other_menu_index>
	change EG_current_layer_info_index = <this_layer_index>
	edit_graphic_update_layer_graphics update_all = 0 index = <other_menu_index>
	edit_graphic_update_layer_graphics update_all = 0 index = <this_menu_index>
	LaunchEvent \{type = focus
		target = edit_graphic_layer_vmenu}
	LaunchEvent type = <pad_event> target = edit_graphic_layer_vmenu
	LaunchEvent \{type = unfocus
		target = edit_graphic_layer_vmenu}
	edit_graphic_layer_vmenu :GetTags
	bar_color = [255 255 255 255]
	SetScreenElementProps {
		id = {<tag_selected_id> child = 0}
		texture = roundbar_middle
		rgba = <bar_color>
	}
	SetScreenElementProps id = {<tag_selected_id> child = 0} scale = (2.5, 0.8) time = 0
	SetScreenElementProps {
		id = {<tag_selected_id> child = text}
		rgba = [100 , 100 , 100 , 255]
	}
	if ($EG_current_layer_menu_index = 9)
		LaunchEvent \{type = pad_up
			target = edit_graphic_tool_vmenu}
		SetScreenElementProps {
			id = {<selected_tool_id> child = 0}
			rgba = $EG_unselectable_text_color
		}
	else
		if ($EG_current_layer_menu_index = 0)
			LaunchEvent \{type = pad_down
				target = edit_graphic_tool_vmenu}
			SetScreenElementProps {
				id = {<selected_tool_id> child = 0}
				rgba = $EG_unselectable_text_color
			}
		else
			rgba = [255 255 255 255]
			SetScreenElementProps {
				id = {<selected_tool_id> child = 0}
				rgba = <rgba>
			}
		endif
	endif
endscript

script edit_graphic_flip_layer 
	if (GotParam horiz)
		<flip_h> = (1 - ($edit_graphic_layer_infos [$EG_current_layer_info_index].flip_h))
		edit_graphic_change_layer_info_value change_flip_h = <flip_h>
	endif
	if (GotParam vert)
		<flip_v> = (1 - ($edit_graphic_layer_infos [$EG_current_layer_info_index].flip_v))
		edit_graphic_change_layer_info_value change_flip_v = <flip_v>
	endif
	edit_graphic_prepare_sprite_infos
	edit_graphic_create_preview
endscript

script edit_graphic_clear_all 
	change edit_graphic_layer_infos = ($default_graphic_layer_info)
	change \{EG_current_layer_menu_index = 0}
	change \{EG_current_layer_info_index = 0}
	if GotParam \{refresh}
		edit_graphic_refresh_cag_texture
	endif
	ui_event \{event = menu_back}
endscript

script edit_graphic_build_image_string 
	<layer_string> = ($edit_graphic_layer_infos [<info_index>].string)
	StringToCharArray string = <layer_string>
	GetArraySize <char_array>
	<font_spacing> = (EG_font_names [($edit_graphic_layer_infos [<info_index>].font_id)].spacing)
	<char_image_size> = ((64.0 / <array_size>))
	<char_x_pos> = ((0 - ((<char_image_size> * <array_size>) / 2)) + (<char_image_size> / 2))
	<char_y_pos> = 0
	<canvas_id> = ($edit_graphic_layer_infos [<info_index>].canvas_id)
	<font> = (EG_font_names [($edit_graphic_layer_infos [<info_index>].font_id)].name)
	<scale> = (<char_image_size> / 64.0)
	if NOT (<array_size> = 1)
		if NOT (<font_spacing> = 0)
			<scale> = (<scale> * (1 / <font_spacing>))
		endif
	endif
	SetScreenElementLock id = <canvas_id> off
	<index> = 0
	begin
	<pos> = (((1.0, 0.0) * <char_x_pos>) + ((0.0, 1.0) * <char_y_pos>))
	<char> = (<char_array> [<index>])
	if (<char> = ' ')
		FormatText checksumname = texture '%f_a' f = <font> l = <char>
		<rgba> = [255 , 255 , 255 , 0]
	else
		FormatText checksumname = texture '%f_%l' f = <font> l = <char>
		HSVtoRGB hsv = ($edit_graphic_layer_infos [<info_index>].hsva)
		<rgba> = <rgb>
	endif
	CreateScreenElement {
		parent = <canvas_id>
		type = SpriteElement
		texture = <texture>
		rgba = <rgba>
		scale = <scale>
		pos = <pos>
		just = [center center]
		z_priority = ($EG_canvas_base_z + <menu_index>)
		tags = {current_texture = <texture>}
		heap = $screen_element_heap
	}
	<char_x_pos> = (<char_x_pos> + <char_image_size>)
	<index> = (<index> + 1)
	repeat <array_size>
	SetScreenElementLock id = <canvas_id>
endscript

script edit_graphic_destroy_image_string \{use_current = 1}
	if (<use_current> = 1)
		<info_index> = $EG_current_layer_info_index
	else
		<info_index> = <info_index>
	endif
	<canvas_id> = ($edit_graphic_layer_infos [<info_index>].canvas_id)
	GetScreenElementChildren id = <canvas_id>
	if (GotParam children)
		SetScreenElementLock id = <canvas_id> off
		GetArraySize <children>
		<index> = 0
		begin
		<child_id> = (<children> [<index>])
		DestroyScreenElement id = <child_id>
		<index> = (<index> + 1)
		repeat <array_size>
		SetScreenElementLock id = <canvas_id>
	endif
endscript

script edit_graphic_get_array_info_vals 
	return ($edit_graphic_layer_infos [<index>])
endscript

script edit_graphic_change_layer_info_value \{use_current = 1}
	if (<use_current> = 1)
		<info_index> = $EG_current_layer_info_index
	else
		<info_index> = <index>
	endif
	edit_graphic_get_array_info_vals index = <info_index>
	if (GotParam change_texture_id)
		<texture_id> = <change_texture_id>
	endif
	if (GotParam change_texture_name)
		<texture_name> = <change_texture_name>
	endif
	if (GotParam change_string)
		<string> = <change_string>
	endif
	if (GotParam change_font_id)
		<font_id> = <change_font_id>
	endif
	if (GotParam change_canvas_id)
		<canvas_id> = <change_canvas_id>
	endif
	if (GotParam change_pos_x)
		<pos_x> = <change_pos_x>
	endif
	if (GotParam change_pos_y)
		<pos_y> = <change_pos_y>
	endif
	if (GotParam change_rot)
		<rot> = <change_rot>
	endif
	if (GotParam change_scale)
		<scale> = <change_scale>
	endif
	if (GotParam change_flip_h)
		<flip_h> = <change_flip_h>
	endif
	if (GotParam change_flip_v)
		<flip_v> = <change_flip_v>
	endif
	if (GotParam change_alpha)
		<alpha> = <change_alpha>
	endif
	if (GotParam change_color)
		<color> = <change_color>
	endif
	if (GotParam change_layer_id)
		<layer_id> = <change_layer_id>
	endif
	SetArrayElement {ArrayName = edit_graphic_layer_infos GlobalArray index = <info_index>
		newvalue = {texture_id = <texture_id> texture_name = <texture_name> string = <string> canvas_id = <canvas_id>
			font_id = <font_id> pos_x = <pos_x> pos_y = <pos_y> rot = <rot> scale = <scale>
			flip_h = <flip_h> flip_v = <flip_v> alpha = <alpha> color = <color> layer_id = <layer_id>
		}
	}
endscript

script edit_graphic_prepare_sprite_infos 
	<sprite_infos> = []
	<index> = 0
	begin
	<layer_info_index> = 0
	begin
	if (($edit_graphic_layer_infos [<layer_info_index>].layer_id) = <index>)
		break
	endif
	<layer_info_index> = (<layer_info_index> + 1)
	repeat 10
	if (($edit_graphic_layer_infos [<layer_info_index>].texture_id) = none)
		StringToCharArray string = ($edit_graphic_layer_infos [<layer_info_index>].string)
		GetArraySize <char_array>
		if (<array_size> > 0)
			edit_graphic_prepare_text_sprite_infos info_index = <layer_info_index>
			<sprite_infos> = (<sprite_infos> + <text_infos>)
		endif
	else
		<posx> = (($edit_graphic_layer_infos [<layer_info_index>].pos_x) - 100)
		<posy> = (100 - ($edit_graphic_layer_infos [<layer_info_index>].pos_y))
		edit_graphic_color_get_rgba index = <layer_info_index>
		<tmp_array> = [
			{
				texture_id = ($edit_graphic_layer_infos [<layer_info_index>].texture_id)
				pos_x = <posx>
				pos_y = <posy>
				rot = ($edit_graphic_layer_infos [<layer_info_index>].rot)
				scale = (($edit_graphic_layer_infos [<layer_info_index>].scale) / 3.0)
				flip_h = ($edit_graphic_layer_infos [<layer_info_index>].flip_h)
				flip_v = ($edit_graphic_layer_infos [<layer_info_index>].flip_v)
				rgba = <rgba>
				layer_id = ($edit_graphic_layer_infos [<layer_info_index>].layer_id)
			}
		]
		<sprite_infos> = (<sprite_infos> + <tmp_array>)
	endif
	<index> = (<index> + 1)
	RemoveParameter \{layer_info_index}
	repeat 10
	return sprite_infos = <sprite_infos>
endscript

script edit_graphic_prepare_text_sprite_infos 
	<layer_string> = ($edit_graphic_layer_infos [<info_index>].string)
	StringToCharArray string = <layer_string>
	GetArraySize <char_array>
	<font_spacing> = (EG_font_names [($edit_graphic_layer_infos [<info_index>].font_id)].spacing)
	<container_scale> = ($edit_graphic_layer_infos [<info_index>].scale)
	<char_image_size> = ((64.0 / <array_size>) * <container_scale>)
	<container_pos_x> = ($edit_graphic_layer_infos [<info_index>].pos_x)
	<char_x_pos> = ((0 - ((<char_image_size> * <array_size>) / 2)) + (<char_image_size> / 2))
	<char_y_pos> = 0
	<font> = (EG_font_names [($edit_graphic_layer_infos [<info_index>].font_id)].name)
	<scale> = (<char_image_size> / 64.0)
	if NOT (<array_size> = 1)
		if NOT (<font_spacing> = 0)
			<scale> = (<scale> * (1 / <font_spacing>))
		endif
	endif
	<rot> = ($edit_graphic_layer_infos [<info_index>].rot)
	HSVtoRGB hsv = ($edit_graphic_layer_infos [<info_index>].hsva)
	<text_infos> = []
	<index> = 0
	begin
	<char> = (<char_array> [<index>])
	if (<char> = ' ')
		FormatText checksumname = texture '%f_a' f = <font> l = <char>
		<rgba> = [0 , 0 , 0 , 0]
	else
		FormatText checksumname = texture '%f_%l' f = <font> l = <char>
		<rgba> = <rgb>
	endif
	Get2DPosFrom2DVec magnitude = <char_x_pos> theta = <rot>
	<tmp_array> = [
		{
			texture_id = <texture>
			pos_x = (<x> + (<container_pos_x> - 32))
			pos_y = (<y> + (($edit_graphic_layer_infos [<info_index>].pos_y) - 32))
			rot = <rot>
			scale = <scale>
			flip_h = ($edit_graphic_layer_infos [<info_index>].flip_h)
			flip_v = ($edit_graphic_layer_infos [<info_index>].flip_v)
			rgba = <rgba>
			layer_id = ($edit_graphic_layer_infos [<info_index>].layer_id)
		}
	]
	<text_infos> = (<text_infos> + <tmp_array>)
	<char_x_pos> = (<char_x_pos> + <char_image_size>)
	<index> = (<index> + 1)
	repeat <array_size>
	<index> = (<array_size> - 1)
	<reverse_infos> = []
	begin
	<tmp_array> = [{(<text_infos> [<index>])}]
	<reverse_infos> = (<reverse_infos> + <tmp_array>)
	<index> = (<index> - 1)
	repeat <array_size>
	return text_infos = <reverse_infos>
endscript

script edit_graphic_apply_graphic_from_save 
	stars

	stars
	return
endscript

script edit_graphic_print_layers 







	<index> = 0
	begin

	if (($edit_graphic_layer_infos [<index>].texture_id) = none)

	else

	endif













	<index> = (<index> + 1)
	repeat 10






endscript

script edit_graphic_set_layer_infos 
	<index> = 0
	begin
	if NOT ((<layer_infos> [<index>].texture_name) = qs(""))
		FormatText checksumname = texture_id '%t' t = (<layer_infos> [<index>].texture_name)
	else
		<texture_id> = none
	endif
	edit_graphic_change_layer_info_value {
		use_current = 0
		index = <index>
		change_texture_id = <texture_id>
		change_texture_name = (<layer_infos> [<index>].texture_name)
		change_string = (<layer_infos> [<index>].string)
		change_font_id = (<layer_infos> [<index>].font_id)
		change_pos_x = (<layer_infos> [<index>].pos_x)
		change_pos_y = (<layer_infos> [<index>].pos_y)
		change_rot = (<layer_infos> [<index>].rot)
		change_scale = (<layer_infos> [<index>].scale)
		change_flip_h = (<layer_infos> [<index>].flip_h)
		change_flip_v = (<layer_infos> [<index>].flip_v)
		change_r = (<layer_infos> [<index>].rgba [0])
		change_g = (<layer_infos> [<index>].rgba [1])
		change_b = (<layer_infos> [<index>].rgba [2])
		change_a = (<layer_infos> [<index>].rgba [3])
		change_layer_id = (<layer_infos> [<index>].layer_id)
	}
	<index> = (<index> + 1)
	repeat 10
endscript

script edit_graphic_color_get_rgba 
	rgba = [255 255 255 255]
	layer = ($edit_graphic_layer_infos [<index>])
	color_lookup = (<layer>.color)
	temp_rgb = ($color_lookup_table.<color_lookup>)
	temp_diffuse = (<temp_rgb>.diffuse)
	AddArrayElement array = <temp_diffuse> element = (<layer>.alpha)
	return rgba = (<array>)
endscript

script edit_graphic_color_wheel 
	if ScreenElementExists \{id = cagr_edit_vmenu}
		DestroyScreenElement \{id = cagr_edit_vmenu}
	endif
	make_generic_menu \{vmenu_id = cagr_edit_vmenu
		title = qs(0x2e665e13)
		num_icons = 0
		show_history}
	if <desc_id> :Desc_ResolveAlias name = alias_banner_art_glow param = banner_glow_id
		<banner_glow_id> :obj_spawnscript ui_flicker_glow params = {as_offset scale_movement = $banner_move glow_brightness = $menu_glow}
	else

	endif
	if <desc_id> :Desc_ResolveAlias name = alias_skulls_glow param = skulls_glow_id
		<skulls_glow_id> :obj_spawnscript ui_flicker_glow params = {as_offset scale_movement = $skulls_move glow_brightness = $menu_glow}
	else

	endif
	layer = ($edit_graphic_layer_infos [($EG_current_layer_info_index)])
	edit_graphic_color_get_rgba index = ($EG_current_layer_info_index)
	colorwheel_add_item {
		scale = 0.6
		pad_choose_script = edit_graphic_color_wheel_accept
		increment_focus_script = edit_graphic_color_wheel_focus_change
		initial_rgb = <rgba>
		special_exit_script = edit_graphic_color_wheel_restore_previous
		special_exit_params = {restore_color = (<layer>.color)}
		no_background = 1
	}
	add_user_control_helper \{text = qs("SELECT")
		button = green
		z = 100000
		all_buttons}
	add_user_control_helper \{text = qs("CANCEL")
		button = red
		z = 100000}
	LaunchEvent \{type = focus
		target = cagr_edit_vmenu
		data = {
			child_index = 0
		}}
	LaunchEvent \{type = pad_choose}
endscript

script edit_graphic_color_wheel_accept 
	if ScreenElementExists \{id = cagr_edit_vmenu}
		DestroyScreenElement \{id = cagr_edit_vmenu}
	endif
	edit_graphic_layer_item_select my_layer = ($EG_current_layer_info_index)
endscript

script edit_graphic_color_wheel_focus_change 
	edit_graphic_change_layer_info_value change_color = <color>
	edit_graphic_create_preview
endscript

script edit_graphic_color_wheel_restore_previous 
	edit_graphic_change_layer_info_value change_color = <restore_color>
	edit_graphic_create_preview
	edit_graphic_color_wheel_accept
endscript

script edit_graphic_delete_layer 
	GetArraySize ($edit_graphic_layer_infos)
	layer_info_size = <array_size>
	index = ($EG_current_layer_info_index)
	if (<index> < <layer_info_size> - 1)
		begin
		temp_value = ($edit_graphic_layer_infos [(<index> + 1)])
		temp_value = {<temp_value> layer_id = <index>}
		SetArrayElement ArrayName = edit_graphic_layer_infos GlobalArray index = <index> newvalue = <temp_value>
		index = (<index> + 1)
		repeat (<layer_info_size> - $EG_current_layer_info_index - 1)
	endif
	SetArrayElement ArrayName = edit_graphic_layer_infos GlobalArray index = (<layer_info_size> - 1) newvalue = ($default_graphic_layer_info [(<layer_info_size> - 1)])
	edit_graphic_create_preview
	edit_graphic_create_main_menu
	ui_event \{event = menu_back}
endscript

script edit_graphic_bring_layer_to_front 
	layer_copy = ($edit_graphic_layer_infos [($EG_current_layer_info_index)])
	GetArraySize ($edit_graphic_layer_infos)
	layer_info_size = <array_size>
	index = ($EG_current_layer_info_index)
	begin
	temp_value = ($edit_graphic_layer_infos [(<index> + 1)])
	temp_value = {<temp_value> layer_id = <index>}
	SetArrayElement ArrayName = edit_graphic_layer_infos GlobalArray index = <index> newvalue = <temp_value>
	index = (<index> + 1)
	repeat (<layer_info_size> - $EG_current_layer_info_index - 1)
	SetArrayElement ArrayName = edit_graphic_layer_infos GlobalArray index = (<layer_info_size> - 1) newvalue = ($default_graphic_layer_info [(<layer_info_size> - 1)])
	<layer_num> = 0
	begin
	if NOT (($edit_graphic_layer_infos [<layer_num>].texture_name) = qs(""))
		<layer_num> = (<layer_num> + 1)
	else
		break
	endif
	repeat (<layer_info_size>)
	layer_copy = {<layer_copy> layer_id = <layer_num>}
	SetArrayElement ArrayName = edit_graphic_layer_infos GlobalArray index = <layer_num> newvalue = <layer_copy>
	change EG_current_layer_info_index = <layer_num>
	edit_graphic_create_preview
	edit_graphic_create_layer_menu
endscript

script edit_graphic_copy_layer 
	layer_copy = ($edit_graphic_layer_infos [($EG_current_layer_info_index)])
	GetArraySize ($edit_graphic_layer_infos)
	layer_info_size = <array_size>
	<layer_num> = 0
	begin
	if NOT (($edit_graphic_layer_infos [<layer_num>].texture_name) = qs(""))
		<layer_num> = (<layer_num> + 1)
	else
		break
	endif
	repeat (<layer_info_size>)
	layer_copy = {<layer_copy> layer_id = <layer_num>}
	SetArrayElement ArrayName = edit_graphic_layer_infos GlobalArray index = <layer_num> newvalue = <layer_copy>
	change EG_current_layer_info_index = <layer_num>
	edit_graphic_create_preview
	edit_graphic_create_layer_menu
endscript

script edit_graphic_load_data 
	change edit_graphic_layer_infos = <data>
	LoadPak \{'pak\\cagr\\cagr_full_set.pak'
		heap = heap_cas}
	edit_graphic_refresh_cag_texture
	UnloadPak \{'pak\\cagr\\cagr_full_set.pak'
		heap = heap_cas}
endscript

script edit_graphic_save_data_to_global controller = ($primary_controller)
	get_savegame_from_controller controller = <controller>
	get_current_band_info
	SetGlobalTags savegame = <savegame> <band_info> params = {band_logo = ($edit_graphic_layer_infos)}
endscript

script edit_graphic_load_data_from_global controller = ($primary_controller)
	get_savegame_from_controller controller = <controller>
	get_current_band_info
	GetGlobalTags savegame = <savegame> <band_info>
	if GotParam \{band_logo}
		GetArraySize <band_logo>
		if (<array_size> > 0)
			edit_graphic_load_data data = <band_logo>
		endif
	endif
endscript

script edit_graphic_refresh_cag_texture 
	edit_graphic_prepare_sprite_infos
	GetCurrentSkaterProfileIndex
	GenerateCAGTexture info_array = <sprite_infos> player = <currentSkaterProfileIndex> test = 0
endscript

script edit_graphic_set_random 
	GetArraySize ($edit_graphic_preset_logos)
	if (<array_size> <= 0)
		debug_ScriptAssert \{qs(0x1bcaf0b6)}
	endif
	GetRandomValue name = rand_index a = 0 b = (<array_size> -1) Integer
	random_entry = (($edit_graphic_preset_logos) [<rand_index>])
	change edit_graphic_layer_infos = <random_entry>
	edit_graphic_refresh_cag_texture
	edit_graphic_save_data_to_global
	ui_event \{event = menu_back}
endscript

script edit_graphic_get_logo_sponsor 
	sponsor_array_names = [
		car_sponsors
	]
	GetArraySize <sponsor_array_names>
	i = 0
	begin
	array_name = (<sponsor_array_names> [(<i>)])
	if is_graphic_in_array array_name = <array_name> texture_id = <texture_id>
		return \{true}
	endif
	i = (<i> + 1)
	repeat <array_size>
	return \{false}
endscript

script is_graphic_in_array 
	GetArraySize ($<array_name>)
	i = 0
	begin
	FormatText checksumname = test_id '%a' a = ($<array_name> [(<i>)])
	if (<test_id> = <texture_id>)
		return \{true}
	endif
	i = (<i> + 1)
	repeat <array_size>
	return \{false}
endscript

script edit_graphic_send_off_to_save_load 
	ui_event_add_params \{skip_destroy = 1}
	if GotParam \{load}
		generic_event_replace \{state = UIstate_cas_save_slots
			data = {
				text = qs("LOAD")
				slot_list = player_created_graphics_save
				load_design
				hist_tex = icon_load
			}}
	elseif GotParam \{save}
		generic_event_choose \{state = UIstate_cas_save_slots
			data = {
				text = qs("SAVE")
				slot_list = player_created_graphics_save
				save_cap
				hist_tex = icon_save
			}}
	else
		debug_ScriptAssert \{qs(0xe440ea6c)}
	endif
endscript

script edit_graphic_find_nearest_open_layer 
	GetArraySize ($edit_graphic_layer_infos)
	layer_info_size = <array_size>
	layer_num = 0
	begin
	if NOT (($edit_graphic_layer_infos [<layer_num>].texture_name) = qs(""))
		<layer_num> = (<layer_num> + 1)
	else
		return true layer_num = <layer_num>
	endif
	repeat (<layer_info_size>)
	return \{false}
endscript
